# Absolute site URL used for canonical links, sitemap and share images.
# Optional on Vercel (falls back to the production *.vercel.app URL).
SITE_URL=

# Neon Postgres — added automatically when you connect Neon from the Vercel Marketplace.
# Local development: any Postgres, e.g. postgres://postgres@localhost:5432/trieuloc
DATABASE_URL=

# Vercel Blob — added automatically when you create a Blob store in Vercel → Storage.
# Only needed to accept photos.
BLOB_READ_WRITE_TOKEN=

# Password for /admin (pick a long one). Changing it signs everyone out.
ADMIN_PASSWORD=

# Email when someone submits a contribution (optional). Free account at https://resend.com.
# Without a verified domain, keep the default sender: Resend then only delivers to
# the email address of your Resend account, so use that address as NOTIFY_EMAIL.
RESEND_API_KEY=
NOTIFY_EMAIL=
# NOTIFY_FROM="Triệu Lộc <thongbao@your-domain.vn>"   # after verifying your domain in Resend
